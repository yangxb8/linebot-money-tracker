# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://nyuenufldaqsjybjhawl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# LINE Login channel (separate from Messaging API bot channel — LIFF must live here)
# Create under the SAME PROVIDER as the bot so user IDs match across channels.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Optional: set to "normal" only after linking a LINE Official Account on the Login channel
# LINE_LOGIN_BOT_PROMPT=normal
NEXT_PUBLIC_LINE_LIFF_ID=

# App URL (OAuth callback base)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional
EXPENSE_PAGE_SIZE=20

# Sentry (optional — omit NEXT_PUBLIC_SENTRY_DSN to disable)
# DSN is public; create project "line-bot-web" in org xubin-yang (or your own).
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Source maps upload at build time (Vercel/CI only — never commit the token)
# SENTRY_AUTH_TOKEN=

# Periodic expense cron (optional — local manual curl to Next.js or Edge Function)
CRON_SECRET=

# Bot rich menu script only (Messaging API channel — not used by Next.js app):
# LINE_CHANNEL_ACCESS_TOKEN=...
# DASHBOARD_LIFF_URL=https://liff.line.me/<LIFF_ID>
